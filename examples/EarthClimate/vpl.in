sSystemName   solarsys # system name
iVerbose      5 # verbosity level
iDigits       16 # output precision
bOverwrite    1 # overwrite existing output
sUnitMass     solar # mass units
sUnitLength   au # length units
sUnitTime     y # time units
sUnitAngle    d # angle units
sUnitTemp     C # temperature units
bDoLog        1 # write log file
saBodyFiles   sun.in earth.in # body input files
bDoForward    1 # forward integration
bVarDt        1 # variable timestep
dEta          0.01 # CFL parameter
dStopTime     1e4 # stop time in years
dOutputTime   1e4 # output interval in years
